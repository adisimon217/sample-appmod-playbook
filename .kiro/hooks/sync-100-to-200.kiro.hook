{
  "enabled": true,
  "name": "Sync 100 → 200 on change",
  "description": "When files in 100-Data-Collection are edited, review the changes and update any affected references in 200-Mod-Feasibility (column names, scoring criteria, data gap lists, extraction mappings).",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "100-Data-Collection/*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file in 100-Data-Collection was just edited. Read the changed file and compare it against the contents of 200-Mod-Feasibility/README.md. If the change introduces new columns, renamed fields, or removed data points in the inventory spreadsheet or README, update 200-Mod-Feasibility/README.md accordingly — specifically the prompt instructions, scoring tables, data gap checklists, and any column references. Only make changes that are directly relevant to what changed in 100-Data-Collection. Do not rewrite sections that are unaffected."
  }
}