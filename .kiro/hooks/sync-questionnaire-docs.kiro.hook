{
  "name": "Sync Questionnaire Changes to Analysis Rules",
  "version": "1.0.0",
  "description": "When the questionnaire template is edited, update the analysis rules to match.",
  "enabled": true,
  "when": {
    "type": "fileEdited",
    "patterns": ["framework/300-Detailed-Assessment/300-App-Questionnaire.md"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "The questionnaire at framework/300-Detailed-Assessment/300-App-Questionnaire.md was just modified. Review the changes and update framework/300-Detailed-Assessment/detailed-analysis.md accordingly: add/update/remove rows in section tables to match question changes, update Q# references, and keep decision matrices consistent."
  }
}