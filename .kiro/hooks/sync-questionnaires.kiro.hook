{
  "name": "Sync Customer Questionnaires",
  "version": "1.0.0",
  "description": "When the questionnaire template is modified, propagate structural changes to all customer questionnaires.",
  "enabled": true,
  "when": {
    "type": "fileEdited",
    "patterns": [".kiro/skills/detailed-assessment/references/300-App-Questionnaire.md"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "The master questionnaire template at .kiro/skills/detailed-assessment/references/300-App-Questionnaire.md was modified. Propagate structural changes to all customer questionnaires in working/*/300-detailed-assessment/*-Questionnaire.md. Update question structure and wording while preserving customer-specific answers."
  }
}
