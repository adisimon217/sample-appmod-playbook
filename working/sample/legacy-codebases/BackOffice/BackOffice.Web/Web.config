<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="telerik" type="Telerik.Web.UI.TelerikConfigurationSection, Telerik.Web.UI" />
  </configSections>

  <connectionStrings>
    <add name="BackOfficeDB" connectionString="Data Source=SQLPROD-BO01;Initial Catalog=BackOfficeDB;Integrated Security=True;MultipleActiveResultSets=True;Connection Timeout=30" providerName="System.Data.SqlClient" />
    <add name="BackOfficeDB_Readonly" connectionString="Data Source=SQLPROD-BO01-RO;Initial Catalog=BackOfficeDB;Integrated Security=True;MultipleActiveResultSets=True;Connection Timeout=30;ApplicationIntent=ReadOnly" providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="ApplicationName" value="BackOffice Operations Portal" />
    <add key="ApplicationVersion" value="4.2.1" />
    <add key="SessionTimeout" value="30" />
    <add key="MaxExportRows" value="50000" />
    <add key="AuditLogEnabled" value="true" />
    <add key="RegistryConfigPath" value="SOFTWARE\FinancialServices\BackOffice" />
    <add key="DisputeAutoEscalationDays" value="5" />
    <add key="ReportCacheDurationMinutes" value="15" />
    <add key="Telerik.Web.UI.RenderMode" value="Lightweight" />
    <add key="Telerik.Skin" value="MetroTouch" />
    <add key="Telerik.ScriptManager.TelerikCdn" value="Disabled" />
    <add key="Telerik.StyleSheetManager.TelerikCdn" value="Disabled" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.5">
      <assemblies>
        <add assembly="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Web.Extensions.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>

    <authentication mode="Windows" />

    <authorization>
      <deny users="?" />
      <allow roles="DOMAIN\BackOffice-Users,DOMAIN\BackOffice-Admins" />
      <deny users="*" />
    </authorization>

    <identity impersonate="false" />

    <sessionState mode="InProc" timeout="30" cookieless="false" />

    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx">
      <error statusCode="403" redirect="~/AccessDenied.aspx" />
      <error statusCode="404" redirect="~/NotFound.aspx" />
    </customErrors>

    <machineKey validationKey="AutoGenerate,IsolateApps" decryptionKey="AutoGenerate,IsolateApps" validation="SHA1" decryption="AES" />

    <pages>
      <controls>
        <add tagPrefix="telerik" namespace="Telerik.Web.UI" assembly="Telerik.Web.UI" />
      </controls>
    </pages>

    <httpHandlers>
      <add path="Telerik.Web.UI.WebResource.axd" type="Telerik.Web.UI.WebResource" verb="*" validate="false" />
      <add path="Telerik.Web.UI.DialogHandler.aspx" type="Telerik.Web.UI.DialogHandler" verb="*" validate="false" />
      <add path="Telerik.Web.UI.SpellCheckHandler.axd" type="Telerik.Web.UI.SpellCheckHandler" verb="*" validate="false" />
      <add path="ChartImage.axd" type="Telerik.Web.UI.ChartHttpHandler" verb="*" validate="false" />
    </httpHandlers>

    <httpModules>
      <add name="AuditModule" type="BackOffice.IISModules.AuditModule, BackOffice.IISModules" />
      <add name="SecurityHeaderModule" type="BackOffice.IISModules.SecurityHeaderModule, BackOffice.IISModules" />
      <add name="SessionValidationModule" type="BackOffice.IISModules.SessionValidationModule, BackOffice.IISModules" />
    </httpModules>

    <trace enabled="true" localOnly="true" pageOutput="false" requestLimit="50" traceMode="SortByTime" />

    <globalization culture="en-US" uiCulture="en-US" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />

    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true">
          <providers>
            <clear />
            <add value="Negotiate" />
            <add value="NTLM" />
          </providers>
        </windowsAuthentication>
      </authentication>
    </security>

    <modules runAllManagedModulesForAllRequests="true">
      <add name="AuditModule" type="BackOffice.IISModules.AuditModule, BackOffice.IISModules" preCondition="managedHandler" />
      <add name="SecurityHeaderModule" type="BackOffice.IISModules.SecurityHeaderModule, BackOffice.IISModules" preCondition="managedHandler" />
      <add name="SessionValidationModule" type="BackOffice.IISModules.SessionValidationModule, BackOffice.IISModules" preCondition="managedHandler" />
    </modules>

    <handlers>
      <add name="Telerik_Web_UI_WebResource_axd" verb="*" preCondition="integratedMode" path="Telerik.Web.UI.WebResource.axd" type="Telerik.Web.UI.WebResource" />
      <add name="Telerik_Web_UI_DialogHandler_aspx" verb="*" preCondition="integratedMode" path="Telerik.Web.UI.DialogHandler.aspx" type="Telerik.Web.UI.DialogHandler" />
      <add name="Telerik_Web_UI_SpellCheckHandler_axd" verb="*" preCondition="integratedMode" path="Telerik.Web.UI.SpellCheckHandler.axd" type="Telerik.Web.UI.SpellCheckHandler" />
      <add name="ChartImage_axd" verb="*" preCondition="integratedMode" path="ChartImage.axd" type="Telerik.Web.UI.ChartHttpHandler" />
    </handlers>

    <staticContent>
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>
  </system.webServer>

  <telerik>
    <webAssets useCdn="false" />
  </telerik>

  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="D:\Logs\BackOffice\application.log" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>
    <appender name="AuditAppender" type="log4net.Appender.RollingFileAppender">
      <file value="D:\Logs\BackOffice\audit.log" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date|%property{UserName}|%property{Action}|%property{Details}%newline" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="RollingFileAppender" />
    </root>
    <logger name="BackOffice.Audit">
      <level value="ALL" />
      <appender-ref ref="AuditAppender" />
    </logger>
  </log4net>
</configuration>
