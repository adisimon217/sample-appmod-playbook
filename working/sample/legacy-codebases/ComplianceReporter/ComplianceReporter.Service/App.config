<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="complianceReporter" type="System.Configuration.NameValueSectionHandler" />
  </configSections>

  <connectionStrings>
    <!-- Read-only access to PayGateDB via Linked Server -->
    <add name="PayGateDB"
         connectionString="Data Source=SQLPROD01;Initial Catalog=ComplianceReporting;Integrated Security=True;Connection Timeout=120"
         providerName="System.Data.SqlClient" />
    <!-- Linked Server reference used in queries: [PAYGATE_SERVER].[PayGateDB].[dbo] -->
  </connectionStrings>

  <appSettings>
    <!-- Service Configuration -->
    <add key="ServiceName" value="VoyagerComplianceReporter" />
    <add key="ServiceDisplayName" value="Voyager Compliance Reporter Service" />
    <add key="ServiceDescription" value="Generates MAS regulatory compliance reports and uploads via SFTP" />

    <!-- Schedule Configuration (runs weekly - Sunday 02:00 AM SGT) -->
    <add key="ScheduleDayOfWeek" value="Sunday" />
    <add key="ScheduleHour" value="2" />
    <add key="ScheduleMinute" value="0" />
    <add key="TimerIntervalMs" value="60000" />

    <!-- SFTP Configuration for MAS Reporting -->
    <add key="SftpHost" value="sftp.mas.gov.sg" />
    <add key="SftpPort" value="22" />
    <add key="SftpUsername" value="voyager_compliance" />
    <add key="SftpPassword" value="encrypted:AQAAAAEAACcQAAAAEH2..." />
    <add key="SftpRemotePath" value="/incoming/regulatory_reports/" />
    <add key="SftpTimeoutSeconds" value="120" />

    <!-- Report Output Configuration -->
    <add key="ReportOutputPath" value="D:\ComplianceReports\Output\" />
    <add key="ReportArchivePath" value="D:\ComplianceReports\Archive\" />
    <add key="ReportRetentionDays" value="2555" />

    <!-- Linked Server Configuration -->
    <add key="LinkedServerName" value="PAYGATE_SERVER" />
    <add key="LinkedServerDatabase" value="PayGateDB" />

    <!-- Windows Event Log -->
    <add key="EventLogSource" value="ComplianceReporter" />
    <add key="EventLogName" value="Application" />

    <!-- MAS Reporting Configuration -->
    <add key="InstitutionCode" value="VOY001" />
    <add key="ReportingEntity" value="Voyager Payment Solutions Pte Ltd" />
    <add key="MasLicenseNumber" value="PS20190001234" />
  </appSettings>

  <system.diagnostics>
    <sources>
      <source name="ComplianceReporter" switchValue="Information">
        <listeners>
          <add name="EventLog" type="System.Diagnostics.EventLogTraceListener"
               initializeData="ComplianceReporter" />
        </listeners>
      </source>
    </sources>
  </system.diagnostics>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
</configuration>
