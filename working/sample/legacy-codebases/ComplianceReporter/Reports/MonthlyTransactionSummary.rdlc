<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <!-- Report Header -->
      <Textbox Name="ReportTitle">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>MAS Monthly Transaction Summary Report</Value>
                <Style>
                  <FontSize>16pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>0.5cm</Top>
        <Left>2cm</Left>
        <Height>1cm</Height>
        <Width>17cm</Width>
      </Textbox>

      <Textbox Name="InstitutionInfo">
        <CanGrow>true</CanGrow>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=Parameters!ReportingEntity.Value &amp; " (" &amp; Parameters!InstitutionCode.Value &amp; ")"</Value>
                <Style>
                  <FontSize>10pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>1.5cm</Top>
        <Left>2cm</Left>
        <Height>0.6cm</Height>
        <Width>17cm</Width>
      </Textbox>

      <!-- Transaction Summary Table -->
      <Tablix Name="TransactionSummaryTable">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>4cm</Width></TablixColumn>
            <TablixColumn><Width>3cm</Width></TablixColumn>
            <TablixColumn><Width>4cm</Width></TablixColumn>
            <TablixColumn><Width>2cm</Width></TablixColumn>
            <TablixColumn><Width>3cm</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow>
              <Height>0.6cm</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="HeaderPaymentType"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Payment Type</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="HeaderCount"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Count</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="HeaderValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Value</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="HeaderCurrency"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Currency</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="HeaderType"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Type</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.6cm</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="PaymentType"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PaymentTypeName.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="TxnCount"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TransactionCount.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="TxnValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!TransactionValue.Value, "N2")</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Currency"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!CurrencyCode.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="TxnType"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TransactionType.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy>
          <TablixMembers>
            <TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember />
          </TablixMembers>
        </TablixColumnHierarchy>
        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
            <TablixMember><Group Name="Detail" /></TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>
        <DataSetName>TransactionSummaryDataSet</DataSetName>
        <Top>3cm</Top>
        <Left>2cm</Left>
        <Height>2cm</Height>
        <Width>16cm</Width>
      </Tablix>

      <!-- Cross-Border Transactions Table -->
      <Tablix Name="CrossBorderTable">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>3cm</Width></TablixColumn>
            <TablixColumn><Width>3cm</Width></TablixColumn>
            <TablixColumn><Width>2cm</Width></TablixColumn>
            <TablixColumn><Width>3cm</Width></TablixColumn>
            <TablixColumn><Width>4cm</Width></TablixColumn>
            <TablixColumn><Width>3cm</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow>
              <Height>0.6cm</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="HeaderOrigin"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Origin</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="HeaderDest"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Destination</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="HeaderCBCurrency"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Currency</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="HeaderCBCount"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Count</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="HeaderCBValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Value</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="HeaderHighValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>High Value</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.6cm</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="Origin"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!OriginCountry.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="Destination"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!DestinationCountry.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="CBCurrency"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!CurrencyCode.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="CBCount"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TransactionCount.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="CBValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!TransactionValue.Value, "N2")</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="HighValueCount"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!HighValueCount.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy>
          <TablixMembers>
            <TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember />
          </TablixMembers>
        </TablixColumnHierarchy>
        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
            <TablixMember><Group Name="CrossBorderDetail" /></TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>
        <DataSetName>CrossBorderDataSet</DataSetName>
        <Top>7cm</Top>
        <Left>2cm</Left>
        <Height>2cm</Height>
        <Width>18cm</Width>
      </Tablix>
    </ReportItems>
    <Height>15cm</Height>
  </Body>
  <Page>
    <PageHeight>29.7cm</PageHeight>
    <PageWidth>21cm</PageWidth>
    <LeftMargin>2cm</LeftMargin>
    <RightMargin>2cm</RightMargin>
    <TopMargin>2cm</TopMargin>
    <BottomMargin>2cm</BottomMargin>
  </Page>
  <ReportParameters>
    <ReportParameter Name="InstitutionCode"><DataType>String</DataType><Prompt>Institution Code</Prompt></ReportParameter>
    <ReportParameter Name="ReportingEntity"><DataType>String</DataType><Prompt>Reporting Entity</Prompt></ReportParameter>
    <ReportParameter Name="ReportingPeriod"><DataType>String</DataType><Prompt>Reporting Period</Prompt></ReportParameter>
    <ReportParameter Name="GeneratedDate"><DataType>String</DataType><Prompt>Generated Date</Prompt></ReportParameter>
  </ReportParameters>
  <DataSources>
    <DataSource Name="ComplianceReportingDS">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=SQLPROD01;Initial Catalog=ComplianceReporting</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="TransactionSummaryDataSet">
      <Fields>
        <Field Name="PaymentTypeName"><DataField>PaymentTypeName</DataField></Field>
        <Field Name="TransactionCount"><DataField>TransactionCount</DataField></Field>
        <Field Name="TransactionValue"><DataField>TransactionValue</DataField></Field>
        <Field Name="CurrencyCode"><DataField>CurrencyCode</DataField></Field>
        <Field Name="TransactionType"><DataField>TransactionType</DataField></Field>
      </Fields>
    </DataSet>
    <DataSet Name="CrossBorderDataSet">
      <Fields>
        <Field Name="OriginCountry"><DataField>OriginCountry</DataField></Field>
        <Field Name="DestinationCountry"><DataField>DestinationCountry</DataField></Field>
        <Field Name="CurrencyCode"><DataField>CurrencyCode</DataField></Field>
        <Field Name="TransactionCount"><DataField>TransactionCount</DataField></Field>
        <Field Name="TransactionValue"><DataField>TransactionValue</DataField></Field>
        <Field Name="HighValueCount"><DataField>HighValueCount</DataField></Field>
      </Fields>
    </DataSet>
    <DataSet Name="MetadataDataSet">
      <Fields>
        <Field Name="InstitutionCode"><DataField>InstitutionCode</DataField></Field>
        <Field Name="ReportingEntity"><DataField>ReportingEntity</DataField></Field>
        <Field Name="ReportType"><DataField>ReportType</DataField></Field>
        <Field Name="ReportingPeriodEnd"><DataField>ReportingPeriodEnd</DataField></Field>
        <Field Name="GeneratedDate"><DataField>GeneratedDate</DataField></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <rd:ReportID>7a3c8f12-4d5e-4b2a-9f1c-3e8d7b6a5c4d</rd:ReportID>
  <rd:ReportUnitType>Cm</rd:ReportUnitType>
</Report>
