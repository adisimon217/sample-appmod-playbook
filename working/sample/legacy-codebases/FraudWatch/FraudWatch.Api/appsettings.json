{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FraudWatch": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "FraudWatch": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "fraudwatch-redis.internal.paycore.local:6379,abortConnect=false,connectTimeout=5000",
    "FraudDb": "Host=fraudwatch-db.internal.paycore.local;Database=FraudWatch;Username=fraudwatch_svc;Password=#{FraudDbPassword}#"
  },
  "BankingApi": {
    "BaseUrl": "https://banking-api.internal.paycore.local",
    "ApiKey": "#{BankingApiKey}#",
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "CircuitBreakerThreshold": 5
  },
  "FraudDetection": {
    "HighRiskThreshold": 0.85,
    "MediumRiskThreshold": 0.55,
    "MaxTransactionAmountUsd": 50000,
    "VelocityWindowMinutes": 60,
    "MaxTransactionsPerWindow": 10,
    "RuleCacheDurationMinutes": 15,
    "EnableRealTimeScoring": true
  },
  "AllowedHosts": "*"
}
