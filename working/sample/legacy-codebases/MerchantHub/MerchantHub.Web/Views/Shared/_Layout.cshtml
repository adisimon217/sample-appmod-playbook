<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MerchantHub</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
        <a class="navbar-brand" href="@Url.Action("Index", "Home")">
            <img src="~/Content/images/logo.png" height="30" alt="MerchantHub" />
            MerchantHub
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            @if (Request.IsAuthenticated)
            {
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Dashboard", "Merchant")">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Transaction")">
                            <i class="fas fa-exchange-alt"></i> Transactions
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Report")">
                            <i class="fas fa-chart-bar"></i> Reports
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Dispute")">
                            <i class="fas fa-exclamation-triangle"></i> Disputes
                            @if (ViewBag.OpenDisputeCount != null && (int)ViewBag.OpenDisputeCount > 0)
                            {
                                <span class="badge badge-danger">@ViewBag.OpenDisputeCount</span>
                            }
                        </a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("InternalSupport"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Admin")">
                                <i class="fas fa-cogs"></i> Admin
                            </a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" data-toggle="dropdown">
                            <i class="fas fa-user"></i> @(Session["UserDisplayName"] ?? User.Identity.Name)
                        </a>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a class="dropdown-item" href="@Url.Action("Profile", "Merchant")">Profile</a>
                            <a class="dropdown-item" href="@Url.Action("Settings", "Merchant")">Settings</a>
                            <a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")">Change Password</a>
                            <div class="dropdown-divider"></div>
                            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                            {
                                @Html.AntiForgeryToken()
                                <a class="dropdown-item" href="javascript:document.getElementById('logoutForm').submit()">Logout</a>
                            }
                        </div>
                    </li>
                </ul>
            }
        </div>
    </nav>

    <div class="container-fluid" style="margin-top: 70px; padding: 20px;">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                @TempData["Error"]
            </div>
        }
        @RenderBody()
    </div>

    <footer class="footer bg-light mt-4 py-3">
        <div class="container text-center">
            <span class="text-muted">
                &copy; @DateTime.Now.Year MerchantHub v@(System.Configuration.ConfigurationManager.AppSettings["MerchantHub.Version"])
                | <a href="@Url.Action("Contact", "Home")">Support</a>
                | <a href="#">Terms of Service</a>
            </span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/datatables")
    @Scripts.Render("~/bundles/jqueryval")
    @RenderSection("scripts", required: false)
</body>
</html>
