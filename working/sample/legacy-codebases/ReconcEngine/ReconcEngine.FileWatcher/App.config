<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="ReconcDB"
         connectionString="Server=SGPROD-SQL02\SQLEXPRESS;Database=ReconcDB;User Id=svc_recon;Password=R3c0nc!l3@2022;Connection Timeout=30;"
         providerName="System.Data.SqlClient" />
